# TiDB Cloud Connection String (MySQL-compatible, SSL enabled automatically)
# Example: mysql://USER.root:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/bakso_berkah
DATABASE_URL=

# Optional alternative individual TiDB Cloud variables (used if DATABASE_URL is empty)
# TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# TIDB_PORT=4000
# TIDB_USER=your_tidb_user
# TIDB_PASSWORD=your_tidb_password
# TIDB_DATABASE=bakso_berkah

# Admin / Kasir Dashboard PIN (default: 1234)
ADMIN_PIN=1234

# Optional secret for signing admin session cookies (defaults to a derived secret)
ADMIN_SESSION_SECRET=bakso-berkah-secret-change-me
